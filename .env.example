# .env.example - Refined for WattCoin Production
# ----------------------------------------------
# ⚠️ Production values must NEVER be committed to the repository!
# Use this file only as a template for your local .env file.

# API Configuration
API_BASE_URL=https://api.wattcoin.example.com
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Discord Integration
# Replace with your actual webhook details in local .env
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_TOKEN

# Security Keys
# ⚠️ MUST be changed in production!
SECRET_KEY=change-me-in-production-use-secrets-manager
API_KEY=your-api-key-here

# ⚠️ DO NOT INCLUDE ACTUAL TOKENS OR PRIVATE KEYS BELOW
WATT_TOKEN_MINT=Gpmbh4PoQnL1kNgpMYDED3iv4fczcr7d3qNBLf8rpump
