# .gitignore - Refined for WattCoin Production
# ------------------------------------------

# Environment variables
.env
.env.*
!.env.example
*.secret
*.key

# Logs
logs/
*.log

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.venv/
env/
venv/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Production configs (DO NOT COMMIT)
config/production.json
config/secrets.yaml

# Temporary files
tmp/
temp/
*.tmp
